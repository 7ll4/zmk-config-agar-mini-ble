#include "./boards/shields/klink_kbd/common.keymap"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        BT1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <14 1>;
            layers = <0>;
        };

        BT2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <2 15>;
            layers = <0>;
        };

        BT3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <3 16>;
            layers = <0>;
        };

        BT4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <4 17>;
            layers = <0>;
        };

        BT0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 18>;
            layers = <0>;
        };

        go0 {
            bindings = <&to 0>;
            key-positions = <17 20>;
            layers = <7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 2 TAB             &kp Q     &kp W        &kp E          &kp R           &kp T  &kp Y  &kp U  &kp I      &kp O    &kp P          &kp BACKSLASH    &kp BACKSPACE
&mt LEFT_CONTROL F13  &kp A     &kp S        &kp D          &kp F           &kp G  &kp H  &kp J  &kp K      &kp L    &kp SEMICOLON  &kp RET
&kp LSHFT             &kp Z     &kp X        &kp C          &kp V           &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH      &kp RIGHT_SHIFT
&kp LEFT_GUI          &kp LALT  &lt 1 SPACE  &kp RIGHT_ALT  &lt 3 CAPSLOCK
            >;
        };

        layer1 {
            bindings = <
&gresc  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DELETE
&mo 3   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans            &trans
&trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH  &kp SEMICOLON         &kp SINGLE_QUOTE       &trans          &trans          &trans           &trans            &trans
&trans  &kp NUMBER_0  &trans        &trans        &trans
            >;
        };

        layer2 {
            bindings = <
&trans  &kp F1  &kp F2        &kp F3   &kp F4   &kp MINUS             &kp SLASH              &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS  &trans  &bootloader
&trans  &kp F5  &kp F6        &kp F7   &kp F8   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL  &trans
&trans  &kp F9  &kp F10       &kp F11  &kp F12  &kp SEMICOLON         &kp SINGLE_QUOTE       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &trans
&trans  &trans  &kp NUMBER_0  &kp DOT  &trans
            >;
        };

        layer3 {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_SEL 0   &trans  &trans  &trans        &trans           &trans      &trans  &to 7
&trans          &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &bt BT_DISC 0  &trans  &trans  &trans        &trans           &trans      &trans
&trans          &bt BT_CLR     &trans         &trans         &trans         &trans         &trans  &trans  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_MUTE  &trans
&bootloader     &trans         &trans         &trans         &trans
            >;
        };

        layer4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans           &trans      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans           &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_MUTE  &trans
&trans  &trans  &trans  &trans  &trans
            >;
        };

        layer5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans
            >;
        };

        layer6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans
            >;
        };

        layer7 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none
            >;
        };
    };
};
